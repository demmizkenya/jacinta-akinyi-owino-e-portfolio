rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio content and media records: public read for all visitors, write for admin/site updates
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Permanent cloud image blobs: public read for all visitors, write for image uploads
    match /portfolio_media_blobs/{blobId} {
      allow read: if true;
      allow write: if true;
    }

    // Contact messages: anyone can create, admin can read and delete
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}
